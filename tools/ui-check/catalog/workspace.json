  "scenarios": [
    {
      "id": "workspace.follow-system",
      "actions": [
        "workspace.settings",
        "workspace.system",
        "workspace.dark",
        "workspace.light",
        "workspace.dismiss"
      ],
      "steps": [
        "Open Settings with the system preference active.",
        "Switch the OS color scheme while Settings is open.",
        "Select Dark; change the OS to light, close, and reload.",
        "Choose Light, then System, and change the OS again."
      ],
      "expected": "The live palette follows the OS only in System mode. The explicit choice and selected radio survive reopening.",
      "risk": "medium"
    },
    {
      "id": "workspace.language-reload",
      "actions": [
        "workspace.language",
        "workspace.help",
        "workspace.help-key",
        "workspace.dismiss"
      ],
      "steps": [
        "Switch English to Russian.",
        "Open Controls with F1, dismiss it, and reload.",
        "Switch back to English and open Controls by mouse."
      ],
      "expected": "Headings and help change language immediately, the preference survives reload, and the note title remains unchanged.",
      "risk": "medium"
    },
    {
      "id": "workspace.local-status",
      "actions": [
        "workspace.status",
        "workspace.status-dismiss",
        "workspace.status-outside",
        "workspace.settings"
      ],
      "steps": [
        "Open local storage status, read the details, and press Escape.",
        "Reopen the status, then click Settings outside it."
      ],
      "expected": "The footer reports local storage without a server address. Escape returns keyboard focus to the footer; clicking Settings opens only that dialog.",
      "risk": "medium"
    },
    {
      "id": "workspace.create-cancel",
      "actions": [
        "workspace.space-menu",
        "workspace.new",
        "workspace.name",
        "workspace.cancel"
      ],
      "steps": [
        "Start creating a space and enter only whitespace.",
        "Enter a valid name and cancel.",
        "Open the switcher again."
      ],
      "expected": "Create stays disabled for whitespace, becomes enabled for the valid name, and cancelling leaves the catalog and active space untouched.",
      "risk": "medium"
    },
    {
      "id": "workspace.space-roundtrip",
      "actions": [
        "workspace.space-menu",
        "workspace.new",
        "workspace.name",
        "workspace.create",
        "workspace.switch"
      ],
      "steps": [
        "Create a space with leading and trailing spaces by pressing Enter.",
        "Switch back to Personal, inspect the original note, and switch to the new space.",
        "Reload."
      ],
      "expected": "The trimmed name survives restart, the new space is empty, and the original note remains in Personal.",
      "risk": "high"
    },
    {
      "id": "workspace.remove-cancel",
      "actions": [
        "workspace.space-menu",
        "workspace.new",
        "workspace.name",
        "workspace.create",
        "workspace.manage",
        "workspace.remove",
        "workspace.keep"
      ],
      "steps": [
        "Create a second space, switch back to Personal and request removal of the second space.",
        "Cancel the confirmation and reopen the space."
      ],
      "expected": "The existing note and the second space both remain available and no deletion is applied.",
      "risk": "high"
    },
    {
      "id": "workspace.remove-local",
      "actions": [
        "workspace.space-menu",
        "workspace.new",
        "workspace.name",
        "workspace.create",
        "workspace.manage",
        "workspace.remove",
        "workspace.confirm"
      ],
      "steps": [
        "Create a second local space.",
        "Delete that active test space after confirmation.",
        "Reload, inspect the switcher, and open the original note."
      ],
      "expected": "The deleted space is absent; Personal remains active and its original note still opens with the same content.",
      "risk": "high"
    },
    {
      "id": "workspace.tag-roundtrip",
      "actions": [
        "workspace.extensions",
        "workspace.open-extension",
        "workspace.tag",
        "workspace.all-tags",
        "workspace.open-tag-note"
      ],
      "steps": [
        "Open the built-in tag explorer with two tagged notes.",
        "Open a shared tag and return to All tags.",
        "Open the same tag again and follow the second note."
      ],
      "expected": "Both notes are listed for the tag. The selected note opens in the editor and the extension overlay closes.",
      "risk": "medium"
    },
    {
      "id": "workspace.bad-import-retry",
      "actions": [
        "workspace.extensions",
        "workspace.import",
        "workspace.apply-language",
        "workspace.language"
      ],
      "steps": [
        "Choose a malformed JSON file, then a valid language pack in the same dialog.",
        "Apply the pack, close the dialog and reload."
      ],
      "expected": "The first attempt shows an import error without installing anything. The second translates the sidebar and the selection survives reload.",
      "risk": "medium"
    },
    {
      "id": "workspace.update-identity",
      "actions": [
        "workspace.extensions",
        "workspace.import",
        "workspace.update-pack",
        "workspace.apply-language"
      ],
      "steps": [
        "Install a test language pack. In Update, select a pack with a different ID.",
        "Retry with the same ID/locale and a changed translation, then activate it."
      ],
      "expected": "The unrelated update is rejected; only one pack remains, with the new translation.",
      "risk": "high"
    },
    {
      "id": "workspace.remove-active-language",
      "actions": [
        "workspace.extensions",
        "workspace.import",
        "workspace.apply-language",
        "workspace.remove-pack",
        "workspace.language"
      ],
      "steps": [
        "Install and activate a language pack, then remove that active pack.",
        "Inspect the sidebar language selector and reload."
      ],
      "expected": "The removed locale vanishes, the interface switches to a built-in language and all notes survive.",
      "risk": "medium"
    },
    {
      "id": "workspace.download-template",
      "actions": [
        "workspace.extensions",
        "workspace.template"
      ],
      "steps": [
        "Download the language template from Extensions and parse the resulting JSON.",
        "Dismiss the manager and check the active language."
      ],
      "expected": "A nonempty language manifest with a messages dictionary is downloaded; no new locale is installed or selected.",
      "risk": "low"
    }
  ]
}
