{
  "apiVersion": 1,
  "id": "example.daily-note",
  "name": "Daily note",
  "description": "Open or create a dated journal entry in this space.",
  "commands": [
    {
      "id": "open-today",
      "title": "Open today's note",
      "scope": "workspace"
    }
  ],
  "permissions": [
    "notes.create"
  ],
  "html": "<style>\n  :root[data-theme=\"light\"] { color-scheme: light }\n  :root[data-theme=\"dark\"] { color-scheme: dark }\n  body { margin: 24px; max-width: 36rem; background: Canvas; color: CanvasText; font: 15px/1.5 system-ui }\n  time { display: block; margin-bottom: .8rem; font-size: 1.25rem; font-weight: 600 }\n  button { font: inherit; cursor: pointer }\n  #open-today { padding: .4rem .85rem; border: 1px solid GrayText; border-radius: .4rem; background: ButtonFace; color: ButtonText }\n  #recent { padding: 0; list-style: none }\n  #recent button { border: none; padding: .25rem 0; background: transparent; color: LinkText; text-decoration: underline }\n</style>\n<time id=\"today\"></time>\n<button id=\"open-today\" type=\"button\" hidden></button>\n<p id=\"hint\"></p>\n<nav id=\"history\" hidden><ul id=\"recent\"></ul></nav>\n<p id=\"status\" role=\"status\"></p>\n<script>\n  const el = id => document.getElementById(id)\n  let russian = false, entries = [], busy = false\n  const label = (en, ru) => russian ? ru : en\n  const localDate = date => [date.getFullYear(), String(date.getMonth()+1).padStart(2,'0'), String(date.getDate()).padStart(2,'0')].join('-')\n  function render() {\n    const now = new Date(), today = localDate(now)\n    el('today').dateTime = today\n    el('today').textContent = now.toLocaleDateString(russian ? 'ru' : 'en', {day:'numeric',month:'long',year:'numeric'})\n    const found = entries.find(note => note.title === today)\n    el('open-today').hidden = !found\n    el('open-today').textContent = label(\"Open today's note\", 'Открыть запись за сегодня')\n    el('hint').hidden = !!found\n    el('hint').textContent = label('Choose “Open today\\'s note” in Extensions to start today’s entry.', 'Чтобы создать запись за сегодня, выберите «Open today\\'s note» в расширениях.')\n    el('recent').replaceChildren()\n    for (const note of entries.filter(note => note.title < today).slice(0,7)) {\n      const row = document.createElement('li'), link = document.createElement('button')\n      link.type = 'button'\n      link.textContent = note.title\n      link.onclick = () => { if (!busy) videron.openNote(note.id) }\n      row.append(link)\n      el('recent').append(row)\n    }\n    el('history').hidden = !el('recent').childElementCount\n    el('history').setAttribute('aria-label', label('Previous daily notes', 'Предыдущие записи'))\n  }\n  async function openToday(canCreate) {\n    if (busy) return\n    const today = localDate(new Date()), found = entries.find(note => note.title === today)\n    if (!found && !canCreate) { render(); return }\n    busy = true\n    el('open-today').disabled = true\n    el('hint').hidden = true\n    try {\n      el('status').textContent = label('Opening…', 'Открываем…')\n      const id = found ? found.id : (await videron.notes.create(today, '#daily')).id\n      videron.openNote(id)\n    } catch (error) {\n      el('status').textContent = error.message + ' ' + label('Reopen the extension to try again.', 'Откройте расширение ещё раз, чтобы повторить.')\n    }\n  }\n  el('open-today').onclick = () => openToday(false)\n  videron.start({\n    onData(data) {\n      russian = data.language === 'ru' || data.language.startsWith('ru-')\n      entries = data.notes.filter(note => /^\\d{4}-\\d{2}-\\d{2}$/.test(note.title) && note.tags.includes('daily'))\n        .sort((a, b) => b.title.localeCompare(a.title))\n      render()\n    },\n    onCommand(command) {\n      if (command.id === 'open-today') openToday(true)\n    }\n  })\n</script>"
}
